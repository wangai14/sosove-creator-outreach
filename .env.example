# Copy this file to .env and fill in only the services you use.
# Never commit the real .env file.

# Public search connectors
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=

# Official Instagram / Meta profile enrichment
# IGAA Instagram Login tokens can enrich only the authorized account itself.
# For other creator handles, use the Facebook/Page-connected professional flow.
META_GRAPH_MODE=
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
META_IG_USER_ID=

# Instagram outreach copy and reply model
OUTREACH_COPY_MODEL_PROVIDER=cpa
OUTREACH_COPY_MODEL_BASE_URL=
OUTREACH_COPY_MODEL_NAME=
OUTREACH_COPY_MODEL_API_KEY=
OUTREACH_COPY_MODEL_AUTH_MODE=bearer
OUTREACH_COPY_MODEL_COMPAT_MODE=cpa
OUTREACH_COPY_MODEL_TIMEOUT=30
OUTREACH_COPY_MODEL_MAX_TOKENS=900

# Optional TikTok-specific model override.
# Leave blank to reuse the Instagram model settings above.
TIKTOK_OUTREACH_COPY_MODEL_PROVIDER=
TIKTOK_OUTREACH_COPY_MODEL_BASE_URL=
TIKTOK_OUTREACH_COPY_MODEL_NAME=
TIKTOK_OUTREACH_COPY_MODEL_API_KEY=

# Persistent data directories
INSTAGRAM_OUTREACH_DATA_DIR=./data/instagram_creator_outreach
TIKTOK_OUTREACH_DATA_DIR=./data/tiktok_creator_outreach

# Optional local harvest integration
INSTAGRAM_DM_OUTREACH_SKILL_DIR=
INSTAGRAM_HARVEST_OUTPUT_DIR=./data/instagram_harvest
