[Unit]
Description=Instagram Creator Outreach Desk
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/instagram-creator-outreach
EnvironmentFile=/opt/instagram-creator-outreach/.env
ExecStart=/usr/bin/python3 -m instagram_creator_outreach.server --host 0.0.0.0 --port 8796
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

