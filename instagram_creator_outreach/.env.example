# Copy this file to .env on your VPS and fill in real values.
# Do not commit .env.

# Public-search APIs
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=

# Official Instagram / Meta Graph API profile enrichment
# Use a token from an Instagram professional account / Page flow.
# Leave META_GRAPH_MODE empty for auto-detect.
# IGAA Instagram Login tokens can only enrich the authorized account itself.
# Facebook/Page tokens with META_IG_USER_ID are needed for business_discovery creator enrichment.
META_GRAPH_MODE=
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
META_IG_USER_ID=

# Outreach copy / reply model
OUTREACH_COPY_MODEL_PROVIDER=cpa
OUTREACH_COPY_MODEL_BASE_URL=
OUTREACH_COPY_MODEL_NAME=
OUTREACH_COPY_MODEL_API_KEY=
OUTREACH_COPY_MODEL_AUTH_MODE=bearer

# Persistent local data directory
INSTAGRAM_OUTREACH_DATA_DIR=./data/instagram_creator_outreach
TIKTOK_OUTREACH_DATA_DIR=./data/tiktok_creator_outreach
